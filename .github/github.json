{
  "defaultBranch": "main",
  "projectType": "native-macos-app",
  "docs": {
    "agentNotes": "AGENTS.md",
    "overview": "README.md",
    "architecture": "docs/architecture.md",
    "developerIDNotarization": "docs/developer-id-notarization.md",
    "targetOverlay": "docs/target-overlay.md",
    "routing": "docs/relay-routing.md",
    "inputMonitoring": "docs/input-monitoring.md",
    "qualification": "docs/samsung-upnp-qualification.md",
    "provenance": "docs/provenance-audit.md",
    "appleCompanionRuntimeProvenance": "docs/apple-companion-runtime-provenance.md",
    "privacy": "docs/privacy.md",
    "appStoreDistribution": "docs/app-store-distribution.md",
    "security": "SECURITY.md",
    "repoSettings": "docs/repo-settings.md",
    "productScope": "docs/product-scope.md"
  },
  "qualityGate": {
    "test": {
      "default": "swift test"
    },
    "validate": {
      "default": "scripts/check.sh"
    },
    "security": {
      "secretScan": "scripts/check-secrets.sh",
      "actionPins": "scripts/check-action-pins.sh",
      "codeScanning": "Analyze Swift"
    },
    "inspection": {
      "ide": "IntelliJ IDEA",
      "scopePreference": [
        "changed_files",
        "directory",
        "whole_project"
      ]
    },
    "docsRequiredWhen": [
      "behavior changes",
      "public API changes",
      "user-visible UI changes",
      "permission or recovery behavior changes",
      "media-target protocol changes",
      "signing or distribution changes",
      "validation gate changes",
      "GitHub repository settings changes"
    ]
  },
  "importantWorkflows": [
    "Validation",
    "CodeQL"
  ],
  "githubSettings": {
    "expected": {
      "hasIssues": true,
      "hasProjects": true,
      "hasWiki": false,
      "allowMergeCommit": true,
      "allowSquashMerge": false,
      "allowRebaseMerge": false,
      "deleteBranchOnMerge": true,
      "actionsDefaultWorkflowPermissions": "read",
      "actionsCanCreatePullRequests": false,
      "actionsRequireShaPinning": false
    }
  },
  "prWorkflow": {
    "watchSkill": "babysit-pr",
    "watchSkillSource": "shared-codex-skills"
  },
  "githubSignals": {
    "postMerge": {
      "waitForActions": true,
      "checkSecurityAndQuality": true
    },
    "capabilities": {
      "codeScanning": "available",
      "secretScanning": "available",
      "secretScanningPushProtection": "available",
      "dependabotSecurityUpdates": "available",
      "securityAdvisories": "available"
    },
    "refreshWhen": [
      "repository visibility changes",
      "branch protection changes",
      "merge settings change",
      "security settings change"
    ]
  },
  "cleanup": {
    "deleteMergedLocalBranches": true,
    "removeMergedCleanWorktrees": true,
    "commands": [
      {
        "name": "git status",
        "command": "git status --short --branch",
        "when": "routine",
        "description": "Confirm the checkout is clean before closeout."
      },
      {
        "name": "worktree list",
        "command": "git worktree list",
        "when": "routine",
        "description": "List linked worktrees so stale generated worktrees are visible."
      }
    ]
  },
  "metadataFreshness": {
    "updateWhen": [
      "validation gates change",
      "important workflows change",
      "runner image policy changes",
      "docs routing changes",
      "branch protection changes",
      "merge settings change",
      "cleanup policy changes",
      "ownership boundaries change"
    ]
  }
}
